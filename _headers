/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Fotos de Instagram: el nombre incluye fecha e identificador, nunca se reutiliza
/fotos/*
  Cache-Control: public, max-age=31536000, immutable

# CSS, JS e imagen social: se revalidan cada día
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# El visor y sus datos tienen que llegar siempre al día: se revalidan en
# cada visita (respuesta 304 cuando no han cambiado). Pesan muy poco, y
# así ningún navegador se queda con una galería vieja durante horas.
/musubi-gallery.js
  Cache-Control: public, max-age=0, must-revalidate
/gallery-data.js
  Cache-Control: public, max-age=0, must-revalidate
/musubigara-og.png
  Cache-Control: public, max-age=604800

# Ficheros de trabajo que no deben aparecer en Google
/LEEME.md
  X-Robots-Tag: noindex, nofollow
/scripts/*
  X-Robots-Tag: noindex, nofollow
/gallery-captions.json
  X-Robots-Tag: noindex, nofollow
